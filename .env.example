# Địa chỉ Jira của bạn (bắt buộc), ví dụ https://jira.example.com
JIRA_BASE_URL=
JIRA_PAT=
# Optional
MAX_ROWS=5000
PAGE_SIZE=100
PORT=8000
# Path to a CA bundle if Jira uses an internal/self-signed certificate
CA_BUNDLE=

# Reminders (optional). Slack: Incoming Webhook URL. Telegram: token from @BotFather.
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
# Minutes after the scheduled time during which a missed reminder is still sent
REMINDER_CATCHUP_MINUTES=120
# Days to keep reminder run history (older entries are cleaned up daily)
REMINDER_HISTORY_DAYS=30
